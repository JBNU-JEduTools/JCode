{
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,

  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#14141E",
    "titleBar.activeForeground": "#F8F8F2",
    "titleBar.inactiveBackground": "#14141E",
    "titleBar.inactiveForeground": "#565B78",

    "activityBar.background": "#14141E",
    "activityBar.foreground": "#BD93F9",
    "activityBar.inactiveForeground": "#565B78",
    "activityBar.activeBorder": "#BD93F9",
    "activityBarBadge.background": "#FF79C6",
    "activityBarBadge.foreground": "#F8F8F2",

    "sideBar.background": "#1A1B26",
    "sideBar.foreground": "#9DA5C0",
    "sideBar.border": "#21222E",
    "sideBarTitle.foreground": "#BD93F9",
    "sideBarSectionHeader.background": "#14141E",
    "sideBarSectionHeader.foreground": "#9DA5C0",

    "editor.background": "#1A1B26",
    "editor.foreground": "#F8F8F2",
    "editor.selectionBackground": "rgba(189, 147, 249, 0.18)",
    "editor.selectionHighlightBackground": "rgba(189, 147, 249, 0.08)",
    "editor.lineHighlightBackground": "#1E1F2E",
    "editor.lineHighlightBorder": "#00000000",
    "editor.wordHighlightBackground": "rgba(189, 147, 249, 0.12)",

    "editorCursor.foreground": "#50FA7B",
    "editorCursor.background": "#1A1B26",
    "editorLineNumber.foreground": "#3B3E54",
    "editorLineNumber.activeForeground": "#9DA5C0",
    "editorIndentGuide.background1": "#21222E",
    "editorIndentGuide.activeBackground1": "#3B3E54",
    "editorBracketMatch.background": "rgba(189, 147, 249, 0.12)",
    "editorBracketMatch.border": "#BD93F9",

    "tab.activeBackground": "#1A1B26",
    "tab.inactiveBackground": "#14141E",
    "tab.activeForeground": "#F8F8F2",
    "tab.inactiveForeground": "#565B78",
    "tab.border": "#14141E",
    "tab.activeBorderTop": "#BD93F9",
    "tab.hoverBackground": "#21222E",
    "editorGroupHeader.tabsBackground": "#14141E",
    "editorGroupHeader.tabsBorder": "#21222E",

    "terminal.background": "#14141E",
    "terminal.foreground": "#F8F8F2",
    "terminal.ansiBlack": "#21222E",
    "terminal.ansiRed": "#FF5555",
    "terminal.ansiGreen": "#50FA7B",
    "terminal.ansiYellow": "#F1FA8C",
    "terminal.ansiBlue": "#BD93F9",
    "terminal.ansiMagenta": "#FF79C6",
    "terminal.ansiCyan": "#8BE9FD",
    "terminal.ansiWhite": "#F8F8F2",
    "terminal.ansiBrightBlack": "#565B78",
    "terminal.ansiBrightRed": "#FF6E6E",
    "terminal.ansiBrightGreen": "#69FF94",
    "terminal.ansiBrightYellow": "#FFFFA5",
    "terminal.ansiBrightBlue": "#D6ACFF",
    "terminal.ansiBrightMagenta": "#FF92DF",
    "terminal.ansiBrightCyan": "#A4FFFF",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "terminalCursor.foreground": "#50FA7B",

    "statusBar.background": "#14141E",
    "statusBar.foreground": "#565B78",
    "statusBar.border": "#21222E",
    "statusBar.noFolderBackground": "#14141E",

    "panel.background": "#14141E",
    "panel.border": "#21222E",
    "panelTitle.activeForeground": "#F8F8F2",
    "panelTitle.activeBorder": "#BD93F9",
    "panelTitle.inactiveForeground": "#565B78",

    "list.activeSelectionBackground": "rgba(189, 147, 249, 0.15)",
    "list.activeSelectionForeground": "#F8F8F2",
    "list.hoverBackground": "rgba(189, 147, 249, 0.08)",
    "list.focusOutline": "#BD93F9",
    "list.highlightForeground": "#8BE9FD",

    "focusBorder": "rgba(189, 147, 249, 0.5)",

    "button.background": "#BD93F9",
    "button.foreground": "#14141E",
    "button.hoverBackground": "#CAA6FF",
    "button.secondaryBackground": "#21222E",
    "button.secondaryForeground": "#F8F8F2",

    "badge.background": "#FF79C6",
    "badge.foreground": "#F8F8F2",

    "input.background": "#14141E",
    "input.foreground": "#F8F8F2",
    "input.border": "#21222E",
    "input.placeholderForeground": "#565B78",

    "dropdown.background": "#14141E",
    "dropdown.border": "#21222E",

    "scrollbarSlider.background": "rgba(86, 91, 120, 0.3)",
    "scrollbarSlider.hoverBackground": "rgba(189, 147, 249, 0.4)",
    "scrollbarSlider.activeBackground": "rgba(189, 147, 249, 0.5)",

    "quickInput.background": "#1A1B26",
    "quickInput.foreground": "#F8F8F2",
    "quickInputList.focusBackground": "rgba(189, 147, 249, 0.15)",

    "widget.shadow": "rgba(0, 0, 0, 0.5)",

    "peekViewEditor.background": "#14141E",
    "peekViewResult.background": "#1A1B26",
    "peekView.border": "#BD93F9",

    "diffEditor.insertedTextBackground": "rgba(80, 250, 123, 0.08)",
    "diffEditor.removedTextBackground": "rgba(255, 85, 85, 0.08)"
  },

  "editor.fontFamily": "'JetBrains Mono', 'Noto Sans KR', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.65,
  "editor.letterSpacing": 0.3,
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 2,
  "editor.smoothScrolling": true,
  "editor.renderWhitespace": "selection",
  "editor.tabSize": 4,
  "editor.wordWrap": "off",
  "editor.stickyScroll.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.occurrencesHighlight": "singleFile",
  "editor.renderLineHighlight": "line",
  "editor.roundedSelection": true,
  "editor.padding.top": 8,

  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,

  "window.menuBarVisibility": "compact",
  "window.commandCenter": false,
  "window.title": "${dirty}${activeEditorShort}${separator}JCode",
  "window.titleBarStyle": "custom",

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.sortOrder": "type",

  "git.enabled": false,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",

  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "update.showReleaseNotes": false,
  "telemetry.telemetryLevel": "off",

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,

  "breadcrumbs.enabled": true,
  "workbench.layoutControl.enabled": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.iconTheme": "vs-minimal"
}
