# JWT 검증을 위한 상수 (Base64 인코딩)
SECRET_KEY = "YOUR_SECRET_KEY_BASE64"
ALGORITHM = "HS256"

# NFS 서버 정보
NFS_SERVER = "your.nfs.server.address"
NFS_PATH = "/yourPath"

# Snapshot NFS 서버 정보
SNAPSHOT_NFS_SERVER = "your.nfs.snapshot.server.address"
SNAPSHOT_NFS_PATH = "/yourSnapshotPath"

# WebIDE Pod service account
SERVICE_ACCOUNT = "your-service-account"

# WebIDE 이미지 설정
# 권장 운영 방식:
# 모든 Workspace 이미지는 Harbor의 commit tag 또는 digest를 사용한다.
CODE_SERVER_IMAGE = "harbor.jbnu.ac.kr/jdevops/code-server:0123456789abcdef"
CODE_SERVER_VNC_IMAGE = "harbor.jbnu.ac.kr/jdevops/code-server-vnc:0123456789abcdef"
WORKSPACE_INIT_IMAGE = "harbor.jbnu.ac.kr/jdevops/workspace-init:0123456789abcdef"
IMAGE_PULL_POLICY = "IfNotPresent"

# Registry fallback이 private registry를 쓸 때만 설정한다.
# 쉼표로 여러 secret 지정 가능: "harbor-jcode-pull,another-pull-secret"
IMAGE_PULL_SECRET_NAMES = ""
IMAGE_PULL_SECRET_SOURCE_NAMESPACE = "watcher"

# code-server 커스텀 이미지 옵션이 필요할 때만 설정한다.
# args를 설정하면 이미지의 기본 CMD를 대체하므로 전체 실행 인자를 모두 적어야 한다.
CODE_SERVER_ARGS = ""
CODE_SERVER_VNC_ARGS = ""
WORKSPACE_ROOT = ""

# Workspace DNS egress. 현재 클러스터의 NodeLocal DNS 주소를 CIDR로 지정한다.
WORKSPACE_DNS_CIDRS = "replace-with-cluster-dns-cidr"

# Starter code zip 제한
STARTER_ZIP_MAX_BYTES = "52428800"
STARTER_ZIP_MAX_UNCOMPRESSED_BYTES = "209715200"
STARTER_ZIP_MAX_FILES = "1000"
